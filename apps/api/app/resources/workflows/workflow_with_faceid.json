{
  "_meta": {
    "title": "角色生成 + FaceID 一致性",
    "description": "使用 IP-Adapter FaceID 注入角色 embedding，保持角色一致性",
    "version": "1.0"
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    },
    "_meta": {"title": "Load Checkpoint"}
  },
  "2": {
    "class_type": "IPAdapterModelLoader",
    "inputs": {
      "ipadapter_file": "ip-adapter-faceid_sdxl.bin"
    },
    "_meta": {"title": "Load IP-Adapter FaceID"}
  },
  "3": {
    "class_type": "InsightFaceLoader",
    "inputs": {
      "provider": "CPU"
    },
    "_meta": {"title": "Load InsightFace"}
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{faceid_reference_image}}"
    },
    "_meta": {"title": "Reference Image", "dynamic": true}
  },
  "5": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["1", 0],
      "ipadapter": ["2", 0],
      "insightface": ["3", 0],
      "image": ["4", 0],
      "weight": 0.7,
      "weight_faceidv2": 0.7,
      "combine_embeds": "average",
      "start_at": 0.0,
      "end_at": 1.0
    },
    "_meta": {"title": "Apply FaceID"}
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "{{positive_prompt}}"
    },
    "_meta": {"title": "Positive Prompt", "dynamic": true}
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "{{negative_prompt}}"
    },
    "_meta": {"title": "Negative Prompt", "dynamic": true}
  },
  "8": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": {"title": "Latent Size"}
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["8", 0],
      "seed": -1,
      "steps": 30,
      "cfg": 7.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0
    },
    "_meta": {"title": "KSampler"}
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["9", 0],
      "vae": ["1", 2]
    },
    "_meta": {"title": "VAE Decode"}
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["10", 0],
      "filename_prefix": "webtoon_faceid"
    },
    "_meta": {"title": "Save Output"}
  }
}
