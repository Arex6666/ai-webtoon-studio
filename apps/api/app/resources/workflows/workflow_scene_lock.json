{
  "_meta": {
    "title": "场景锁定生成",
    "description": "使用 ControlNet 锁定场景结构，保持空间一致性",
    "version": "1.0"
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    },
    "_meta": {"title": "Load Checkpoint"}
  },
  "2": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "control_v11f1p_sd15_depth.safetensors"
    },
    "_meta": {"title": "Load Depth ControlNet"}
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{depth_map_image}}"
    },
    "_meta": {"title": "Depth Map", "dynamic": true}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "{{positive_prompt}}"
    },
    "_meta": {"title": "Positive Prompt", "dynamic": true}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["1", 1],
      "text": "{{negative_prompt}}"
    },
    "_meta": {"title": "Negative Prompt", "dynamic": true}
  },
  "6": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["4", 0],
      "negative": ["5", 0],
      "control_net": ["2", 0],
      "image": ["3", 0],
      "strength": 0.6,
      "start_percent": 0.0,
      "end_percent": 1.0
    },
    "_meta": {"title": "Apply Depth ControlNet"}
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": {"title": "Latent Size"}
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["6", 0],
      "negative": ["6", 1],
      "latent_image": ["7", 0],
      "seed": -1,
      "steps": 30,
      "cfg": 7.0,
      "sampler_name": "euler_ancestral",
      "scheduler": "normal",
      "denoise": 1.0
    },
    "_meta": {"title": "KSampler"}
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["1", 2]
    },
    "_meta": {"title": "VAE Decode"}
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "webtoon_scene"
    },
    "_meta": {"title": "Save Output"}
  }
}
