{
    "name": "flux_ipadapter",
    "version": "1.0.0",
    "description": "Flux + IP-Adapter 角色一致性生成",
    "nodes": {
        "1": {
            "inputs": {
                "unet_name": "flux1-dev.safetensors",
                "weight_dtype": "default"
            },
            "class_type": "UNETLoader",
            "_meta": {
                "title": "Load Diffusion Model"
            }
        },
        "2": {
            "inputs": {
                "clip_name1": "t5xxl_fp8_e4m3fn.safetensors",
                "clip_name2": "clip_l.safetensors",
                "type": "flux"
            },
            "class_type": "DualCLIPLoader"
        },
        "3": {
            "inputs": {
                "vae_name": "ae.safetensors"
            },
            "class_type": "VAELoader"
        },
        "10": {
            "inputs": {
                "ipadapter_file": "ip-adapter_flux.safetensors"
            },
            "class_type": "IPAdapterModelLoader",
            "_meta": {
                "title": "Load IP-Adapter"
            }
        },
        "11": {
            "inputs": {
                "clip_name": "clip-vit-large-patch14.safetensors"
            },
            "class_type": "CLIPVisionLoader",
            "_meta": {
                "title": "Load CLIP Vision"
            }
        },
        "12": {
            "inputs": {
                "image": "{{reference_image}}"
            },
            "class_type": "LoadImage",
            "_meta": {
                "title": "Load Reference Image"
            }
        },
        "13": {
            "inputs": {
                "model": [
                    "1",
                    0
                ],
                "ipadapter": [
                    "10",
                    0
                ],
                "image": [
                    "12",
                    0
                ],
                "clip_vision": [
                    "11",
                    0
                ],
                "weight": "{{ipadapter_weight}}",
                "weight_type": "linear",
                "start_at": 0,
                "end_at": 1
            },
            "class_type": "IPAdapterApply",
            "_meta": {
                "title": "Apply IP-Adapter"
            }
        },
        "4": {
            "inputs": {
                "text": "{{positive_prompt}}",
                "clip": [
                    "2",
                    0
                ]
            },
            "class_type": "CLIPTextEncode"
        },
        "5": {
            "inputs": {
                "width": "{{width}}",
                "height": "{{height}}",
                "batch_size": 1
            },
            "class_type": "EmptySD3LatentImage"
        },
        "6": {
            "inputs": {
                "noise": [
                    "7",
                    0
                ],
                "guider": [
                    "8",
                    0
                ],
                "sampler": [
                    "9",
                    0
                ],
                "sigmas": [
                    "14",
                    0
                ],
                "latent_image": [
                    "5",
                    0
                ]
            },
            "class_type": "SamplerCustomAdvanced"
        },
        "7": {
            "inputs": {
                "noise_seed": "{{seed}}"
            },
            "class_type": "RandomNoise"
        },
        "8": {
            "inputs": {
                "model": [
                    "13",
                    0
                ],
                "conditioning": [
                    "4",
                    0
                ]
            },
            "class_type": "BasicGuider"
        },
        "9": {
            "inputs": {
                "sampler_name": "{{sampler}}"
            },
            "class_type": "KSamplerSelect"
        },
        "14": {
            "inputs": {
                "scheduler": "{{scheduler}}",
                "steps": "{{steps}}",
                "denoise": 1,
                "model": [
                    "13",
                    0
                ]
            },
            "class_type": "BasicScheduler"
        },
        "15": {
            "inputs": {
                "samples": [
                    "6",
                    0
                ],
                "vae": [
                    "3",
                    0
                ]
            },
            "class_type": "VAEDecode"
        },
        "16": {
            "inputs": {
                "filename_prefix": "webtoon/ipadapter",
                "images": [
                    "15",
                    0
                ]
            },
            "class_type": "SaveImage"
        }
    },
    "defaults": {
        "positive_prompt": "masterpiece, best quality",
        "width": 1080,
        "height": 1920,
        "seed": 42,
        "steps": 20,
        "sampler": "euler",
        "scheduler": "normal",
        "ipadapter_weight": 0.8,
        "reference_image": ""
    }
}