# ============ 数据库 ============
DATABASE_URL=postgresql://user:password@localhost:5432/webtoon_studio
# 或使用 SQLite 进行开发: sqlite:///./webtoon_studio.db

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0

# ============ MinIO / S3 ============
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=webtoon-studio
MINIO_SECURE=false

# ============ ComfyUI (可选) ============
# 如果不配置，将使用 Mock 模式
COMFYUI_URL=http://localhost:8188

# ============ LLM 配置 (可选) ============
# 支持: openai, deepseek, tongyi, doubao
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Deepseek
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 通义千问
# TONGYI_API_KEY=sk-xxx
# TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TONGYI_MODEL=qwen-plus

# 豆包
# DOUBAO_API_KEY=xxx
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=doubao-pro-32k

# ============ JWT 认证 ============
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ CORS ============
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# ============ 日志 ============
LOG_LEVEL=INFO
